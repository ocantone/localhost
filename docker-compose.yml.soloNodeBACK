services:
 
  php:
    image: php:8.2-fpm
    container_name: php-fpm
    volumes:
      - ./:/var/www/html
      - ./redes1b.unm.local:/var/www/html/redes1b.unm.local
      - ./prog3.utn.local:/var/www/html/prog3.utn.local

  nginx:
    image: nginx:1.24
    container_name: nginx
    ports:
      - "80:80"
    volumes:
      - ./configNginx/default.conf:/etc/nginx/conf.d/default.conf
      - ./:/var/www/html
      - ./redes1b.unm.local:/var/www/html/redes1b.unm.local
      - ./prog3.utn.local:/var/www/html/prog3.utn.local
    depends_on:
      - php
      - db

  db:
    image: mysql:8.4.2
    container_name: db
    environment:
      MYSQL_ROOT_PASSWORD: admin1234
      MYSQL_DATABASE: datos
      MYSQL_USER: prog3
      MYSQL_PASSWORD: admin123
    volumes:
      - ./baseDatosWeb:/var/lib/mysql
    ports:
      - "3306:3306"

  phpmyadmin:
    image: phpmyadmin/phpmyadmin:5.1.1
    container_name: phpmyadmin
    environment:
      PMA_HOST: db
      PMA_USER: prog3
      PMA_PASSWORD: admin123
    ports:
      - "8080:80"
    depends_on:
      - db

  backend:
    image: node:20-alpine
    container_name: node-backend
    working_dir: /usr/src/app
    volumes:
      - ./prog3.utn.local/api:/usr/src/app
    ports:
      - "3000:3000"
    command: npm start
    depends_on:
      - db